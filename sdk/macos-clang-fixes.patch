+/* The macOS USB backend (unix/osx/libfli-usb-sys.c) provides these directly.
+   Declare them here so callers in libfli.c compile under clang's strict
+   (C99+) rules. unix_usbio() calls unix_fli_lock()/unix_fli_unlock() by name,
+   so those are redirected to the mac_* implementations; correspondingly,
+   libfli-sys.c must NOT compile its own unix_fli_lock/unlock on __APPLE__
+   (guarded there) to avoid duplicate symbols. */
